# OPENAI_API_KEY: Secret key for OpenAI API (used server-side for OP vision & text parsing)
OPENAI_API_KEY=

# OPENAI_MODEL: Configurable OpenAI model for OP interpretation (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# GEMINI_API_KEY: Optional Gemini AI key for fallback
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# GOOGLE CLOUD SERVICE ACCOUNT (JSON string or Base64 string for firebase-admin and googleapis)
GOOGLE_SERVICE_ACCOUNT_KEY=

# GOOGLE DRIVE ROOT FOLDER (ID of the destination root folder in Google Drive)
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# FIRESTORE / FIREBASE CONFIGURATION (Optional overrides)
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
FIREBASE_STORAGE_BUCKET=

